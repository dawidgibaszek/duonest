#!/usr/bin/env bash
set -euo pipefail

args=()
for arg in "$@"; do
  case "$arg" in
    --dangerously-skip-permissions) ;;
    *) args+=("$arg") ;;
  esac
done

# Cezar's Antigravity runner adds an unrestricted permission flag by default.
for arg in "${args[@]}"; do
  if [[ "$arg" == --input-format || "$arg" == --input-format=* ]]; then
    exec agy --sandbox --mode auto "${args[@]}"
  fi
done

exec agy "${args[@]}"
