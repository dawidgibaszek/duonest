{
  "rules": {
    ".read": false,
    ".write": false,
    "members": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "live": {
      "transient": {
        "$channel": {
          ".read": "auth != null && root.child('members').child(auth.uid).child('partnership_id').isString() && !root.child('revoked_partnerships').child(root.child('members').child(auth.uid).child('partnership_id').val()).exists() && $channel === 'duonest_channel_' + root.child('members').child(auth.uid).child('partnership_id').val()",
          ".indexOn": [
            "ts"
          ],
          "$msgId": {
            ".write": "auth != null && root.child('members').child(auth.uid).child('partnership_id').isString() && !root.child('revoked_partnerships').child(root.child('members').child(auth.uid).child('partnership_id').val()).exists() && $channel === 'duonest_channel_' + root.child('members').child(auth.uid).child('partnership_id').val() && ((!data.exists() && newData.exists() && newData.child('payload').child('senderId').val() === root.child('members').child(auth.uid).child('profile_id').val()) || (data.exists() && !newData.exists() && data.child('ts').isNumber() && data.child('ts').val() <= now - 600000))",
            ".validate": "newData.child('event').val() === 'duo_sync' && newData.child('ts').isNumber() && newData.child('ts').val() >= now - 5000 && newData.child('ts').val() <= now && (newData.child('payload').child('action').val() === 'HEARTBEAT' || newData.child('payload').child('action').val() === 'DOODLE_LIVE_STROKE' || newData.child('payload').child('action').val() === 'DOODLE_DRAWING_STATUS')",
            "event": {
              ".validate": "newData.val() === 'duo_sync'"
            },
            "ts": {
              ".validate": "newData.isNumber()"
            },
            "payload": {
              ".validate": "newData.hasChildren(['action', 'senderId', 'data'])",
              "action": {
                ".validate": "newData.isString()"
              },
              "senderId": {
                ".validate": "newData.isString()"
              },
              "data": {
                "isDrawing": {
                  ".validate": "newData.isBoolean()"
                },
                "stroke": {
                  ".validate": "newData.hasChildren(['color', 'width', 'points'])",
                  "id": {
                    ".validate": "newData.isString() && newData.val().matches(/^[a-zA-Z0-9-]{1,64}$/)"
                  },
                  "color": {
                    ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
                  },
                  "width": {
                    ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 100"
                  },
                  "isEraser": {
                    ".validate": "newData.isBoolean()"
                  },
                  "points": {
                    "$index": {
                      ".validate": "$index.matches(/^[0-9]{1,4}$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
                    }
                  },
                  "$other": {
                    ".validate": false
                  }
                },
                "user_id": {
                  ".validate": "newData.val() === root.child('members').child(auth.uid).child('profile_id').val()"
                },
                "at": {
                  ".validate": "newData.isString() && newData.val().length <= 40"
                },
                "$other": {
                  ".validate": false
                }
              },
              "$other": {
                ".validate": false
              }
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "music": {
        "$partnershipId": {
          ".read": "auth != null && root.child('members').child(auth.uid).child('partnership_id').val() === $partnershipId && !root.child('revoked_partnerships').child($partnershipId).exists()",
          ".write": false
        }
      },
      "presence_v2": {
        "$channel": {
          ".read": "auth != null && root.child('members').child(auth.uid).child('partnership_id').isString() && !root.child('revoked_partnerships').child(root.child('members').child(auth.uid).child('partnership_id').val()).exists() && $channel === 'duonest_channel_' + root.child('members').child(auth.uid).child('partnership_id').val()",
          "$key": {
            "$session": {
              ".write": "auth != null && root.child('members').child(auth.uid).child('partnership_id').isString() && !root.child('revoked_partnerships').child(root.child('members').child(auth.uid).child('partnership_id').val()).exists() && $channel === 'duonest_channel_' + root.child('members').child(auth.uid).child('partnership_id').val() && $key === root.child('members').child(auth.uid).child('profile_id').val()",
              ".validate": "newData.hasChildren(['updated_at'])",
              "updated_at": {
                ".validate": "newData.isNumber() && newData.val() >= now - 5000 && newData.val() <= now"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        }
      }
    }
  }
}
