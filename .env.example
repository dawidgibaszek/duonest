# Supabase Configuration for DuoNest
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
SUPABASE_DB_PASS=your-db-password

# Web Push Notifications (VAPID Keys)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT=mailto:twoj-kontakt@domena.pl

# Groq AI (Recipe formatting)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=qwen/qwen3.8-27b

# Spotify OAuth (server-side only)
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback
NUXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
