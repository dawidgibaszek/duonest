rules_version = '2';

// DuoNest – Firestore security rules
//
// Access model:
//  - `members/{uid}` (written ONLY by the server: /api/account/sync, /api/pairing/*)
//    maps a Firebase Auth user to their profile id and verified partnership id.
//  - A user can read/write their own profile and read their partner's profile.
//  - Shared data (shopping, tasks, events, …) is accessible only to members of
//    the partnership stored in the document's `partnership_id`.
//  - Pairing, disconnecting and linking accounts happen server-side (admin SDK),
//    so clients can never change `partnership_id`, `auth_user_id` or partnership members.
//  - Everything else (push_subscriptions, rate_limits, music_*, …) is server-only.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function memberPath() {
      return /databases/$(database)/documents/members/$(request.auth.uid);
    }

    function myPartnershipId() {
      return exists(memberPath()) ? get(memberPath()).data.get('partnership_id', null) : null;
    }

    function inPartnership(pid) {
      return signedIn() && pid is string && myPartnershipId() == pid;
    }

    function isSharedCollection(c) {
      return c in [
        'shopping_items',
        'tasks',
        'events',
        'mood_logs',
        'nudges',
        'milestones',
        'wishlist_items',
        'savings_goals',
        'savings_contributions',
        'partnership_doodles',
        'meals',
        'movies'
      ];
    }

    // Membership index – server-managed
    match /members/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Profiles
    match /profiles/{profileId} {
      allow get: if signedIn() && (
        profileId == request.auth.uid ||
        resource.data.get('auth_user_id', null) == request.auth.uid ||
        inPartnership(resource.data.get('partnership_id', null))
      );
      allow list: if signedIn() && (
        resource.data.get('auth_user_id', null) == request.auth.uid ||
        inPartnership(resource.data.get('partnership_id', null))
      );
      // New profiles live at profiles/{uid} and start unpaired.
      allow create: if signedIn()
        && profileId == request.auth.uid
        && request.resource.data.auth_user_id == request.auth.uid
        && request.resource.data.get('partnership_id', null) == null;
      // Owners may edit their profile, but not identity / pairing fields.
      allow update: if signedIn()
        && resource.data.get('auth_user_id', null) == request.auth.uid
        && request.resource.data.get('auth_user_id', null) == resource.data.get('auth_user_id', null)
        && request.resource.data.get('partnership_id', null) == resource.data.get('partnership_id', null)
        && request.resource.data.get('id', null) == resource.data.get('id', null)
        && (
          request.resource.data.get('pairing_code', null) == resource.data.get('pairing_code', null) ||
          resource.data.get('pairing_code', null) == null
        );
      allow delete: if false;
    }

    // Partnerships (created/deleted only by the server)
    match /partnerships/{pid} {
      allow get: if inPartnership(pid);
      allow list: if false;
      allow update: if inPartnership(pid)
        && request.resource.data.get('partner1_id', null) == resource.data.get('partner1_id', null)
        && request.resource.data.get('partner2_id', null) == resource.data.get('partner2_id', null)
        && request.resource.data.get('id', null) == resource.data.get('id', null);
      allow create, delete: if false;

      // Per-partnership mirrors of shared data
      match /{sub}/{docId} {
        allow read, write: if inPartnership(pid);
      }
    }

    // Shared partnership data
    match /{coll}/{docId} {
      allow read: if isSharedCollection(coll)
        && inPartnership(resource.data.get('partnership_id', null));
      allow create: if isSharedCollection(coll)
        && inPartnership(request.resource.data.get('partnership_id', null));
      allow update: if isSharedCollection(coll)
        && inPartnership(resource.data.get('partnership_id', null))
        && request.resource.data.get('partnership_id', null) == resource.data.get('partnership_id', null);
      allow delete: if isSharedCollection(coll)
        && inPartnership(resource.data.get('partnership_id', null));
    }
  }
}
