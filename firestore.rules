rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberPath() {
      return /databases/$(database)/documents/members/$(request.auth.uid);
    }

    function isActiveProfile(pid, profileId) {
      let profile = get(/databases/$(database)/documents/profiles/$(profileId));
      let nest = get(/databases/$(database)/documents/partnerships/$(pid));
      return profile.data.get('auth_user_id', null) == request.auth.uid
        && profile.data.get('partnership_id', null) == pid
        && profileId in [nest.data.partner1_id, nest.data.partner2_id];
    }

    function matchingMember(pid) {
      let member = get(memberPath());
      return member.data.get('partnership_id', null) == pid
        && member.data.get('profile_id', null) is string
        && isActiveProfile(pid, member.data.profile_id);
    }

    function inPartnership(pid) {
      return signedIn() && pid is string && matchingMember(pid);
    }

    function isMe(profileId) {
      return signedIn() && profileId is string
        && (profileId == request.auth.uid || profileId == get(memberPath()).data.get('profile_id', null));
    }

    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function samePartnership() {
      return inPartnership(resource.data.partnership_id)
        && request.resource.data.partnership_id == resource.data.partnership_id;
    }

    function newShared(id) {
      return request.resource.data.id == id
        && inPartnership(request.resource.data.partnership_id);
    }

    match /members/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
    }

    function validSelection(selection, allowed) {
      return selection is list && selection.size() == selection.toSet().size() && selection.hasOnly(allowed);
    }

    match /profiles/{id} {
      allow get: if signedIn() && (
        (id == request.auth.uid && (resource == null || resource.data.get('auth_user_id', null) == null)) ||
        resource.data.get('auth_user_id', null) == request.auth.uid
      );
      allow list: if signedIn() && resource.data.get('auth_user_id', null) == request.auth.uid;

      allow update: if signedIn() && resource.data.get('auth_user_id', null) == request.auth.uid
        && changedOnly([
          'name', 'avatar_color', 'current_mood', 'mood_note', 'mood_updated_at',
          'love_note', 'gender', 'grammatical_gender',
          'enabled_features', 'nest_cards', 'onboarding_stage', 'onboarding_partnership_id', 'show_location_widget',
          'last_seen_at', 'updated_at'
        ])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['gender'])
          || request.resource.data.get('gender', null) in [null, 'male', 'female', 'nonbinary'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['grammatical_gender'])
          || request.resource.data.get('grammatical_gender', null) in [
            null, 'female', 'male', 'neutral', 'impersonal'
          ])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['enabled_features'])
          || validSelection(request.resource.data.enabled_features, [
            'shopping', 'tasks', 'meals', 'savings', 'pet', 'calendar', 'movies', 'wishlist'
          ]))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['nest_cards'])
          || validSelection(request.resource.data.nest_cards, [
            'summary', 'points', 'rewards', 'mood', 'music', 'gestures', 'today', 'doodle', 'shortcuts', 'location'
          ]))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['show_location_widget'])
          || request.resource.data.show_location_widget is bool)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['onboarding_stage'])
          || (resource.data.get('onboarding_stage', null) in [null, 'profile']
            && request.resource.data.onboarding_stage == 'features')
          || (resource.data.get('onboarding_stage', null) == 'features' && request.resource.data.onboarding_stage == 'complete'))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['onboarding_partnership_id'])
          || (request.resource.data.onboarding_stage == 'complete'
            && request.resource.data.onboarding_partnership_id is string
            && request.resource.data.onboarding_partnership_id == resource.data.get('partnership_id', null)
            && inPartnership(request.resource.data.onboarding_partnership_id)));
    }

    match /partner_profiles/{id} {
      allow get: if inPartnership(resource.data.partnership_id)
        && id in [
          get(/databases/$(database)/documents/partnerships/$(resource.data.partnership_id)).data.partner1_id,
          get(/databases/$(database)/documents/partnerships/$(resource.data.partnership_id)).data.partner2_id
        ];
    }

    match /partnerships/{pid} {
      allow get: if inPartnership(pid);
      allow update: if inPartnership(pid)
        && changedOnly(['nest_name', 'anniversary_date', 'pet_id', 'pet_name', 'updated_at'])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['pet_id', 'pet_name']) ||
          (request.resource.data.pet_id in ['Cat', 'Dog', 'Bear', 'Bunny', 'Chick', 'Dragon', 'Fox', 'Frog', 'Ghost', 'Panda', 'Penguin', 'Slime']
            && request.resource.data.pet_name is string
            && request.resource.data.pet_name.size() > 0 && request.resource.data.pet_name.size() <= 40)
        );
      // Legacy per-partnership mirrors are private. Clients use top-level collections.
    }

    match /partnership_locations/{pid}/location_fixes/{profileId} {
      allow get: if inPartnership(pid)
        && (resource == null || resource.data.expires_at > request.time);
    }

    match /tasks/{id} {
      allow read: if inPartnership(resource.data.partnership_id);
      allow create: if newShared(id)
        && isMe(request.resource.data.created_by)
        && request.resource.data.get('deleted_at', null) == null
        && request.resource.data.points is int
        && request.resource.data.points >= 1
        && request.resource.data.points <= 100
        && request.resource.data.is_completed == false
        && request.resource.data.get('completed_by', null) == null
        && request.resource.data.get('completed_at', null) == null
        && request.resource.data.get('points_awarded', 0) == 0;
      allow update: if samePartnership() && changedOnly([
        'title', 'description', 'assigned_to', 'due_date', 'is_recurring', 'recurrence_interval', 'updated_at'
      ]) && resource.data.get('deleted_at', null) == null;
    }

    match /milestones/{id} {
      allow read, delete: if inPartnership(resource.data.partnership_id);
      allow create: if newShared(id)
        && isMe(request.resource.data.created_by)
        && request.resource.data.is_completed == false
        && request.resource.data.get('completed_at', null) == null
        && request.resource.data.target_points is number && request.resource.data.target_points >= 10;
      allow update: if samePartnership()
        && changedOnly(['title', 'description', 'assigned_to', 'target_points', 'updated_at'])
        && request.resource.data.target_points is number && request.resource.data.target_points >= 10;
    }

    match /savings_goals/{id} {
      allow read: if inPartnership(resource.data.partnership_id);
    }

    match /savings_contributions/{id} {
      allow read: if inPartnership(resource.data.partnership_id);
    }

    match /wishlist_items/{id} {
      function mayRead(data) {
        return inPartnership(data.partnership_id)
          && (isMe(data.get('created_by', null)) || data.get('is_visible_to_partner', false) == true);
      }

      allow read, delete: if mayRead(resource.data);
      allow create: if newShared(id)
        && isMe(request.resource.data.created_by)
        && request.resource.data.is_visible_to_partner is bool;
      allow update: if samePartnership() && mayRead(resource.data)
        && request.resource.data.get('id', null) == resource.data.get('id', null)
        && request.resource.data.get('created_by', null) == resource.data.get('created_by', null)
        && request.resource.data.get('is_visible_to_partner', false) is bool
        && (isMe(resource.data.get('created_by', null)) ||
          request.resource.data.get('is_visible_to_partner', false) == resource.data.get('is_visible_to_partner', false));
    }

    match /nudges/{id} {
      allow read, delete: if inPartnership(resource.data.partnership_id);
      allow create: if newShared(id)
        && isMe(request.resource.data.sender_id)
        && !isMe(request.resource.data.receiver_id)
        && request.resource.data.receiver_id in [
          get(/databases/$(database)/documents/partnerships/$(request.resource.data.partnership_id)).data.partner1_id,
          get(/databases/$(database)/documents/partnerships/$(request.resource.data.partnership_id)).data.partner2_id
        ];
    }

    match /movies/{id} {
      function reviewsAreValid() {
        let before = resource.data.get('reviews', {});
        let after = request.resource.data.get('reviews', {});
        let me = get(memberPath()).data.profile_id;
        let mine = after.get(me, null);
        return before == after || (after.diff(before).affectedKeys().hasOnly([me])
          && mine is map && mine.user_id == me
          && mine.rating is int && mine.rating >= 1 && mine.rating <= 10);
      }

      allow read, delete: if inPartnership(resource.data.partnership_id);
      allow create: if newShared(id) && isMe(request.resource.data.added_by)
        && request.resource.data.get('reviews', {}) == {};
      allow update: if samePartnership()
        && request.resource.data.id == resource.data.id
        && request.resource.data.get('added_by', null) == resource.data.get('added_by', null)
        && reviewsAreValid();
    }

    function isSharedCollection(collection) {
      return collection in ['shopping_items', 'events', 'mood_logs', 'partnership_doodles', 'meals'];
    }

    match /{collection}/{id} {
      allow read, delete: if isSharedCollection(collection) && inPartnership(resource.data.partnership_id);
      allow create: if isSharedCollection(collection) && newShared(id);
      allow update: if isSharedCollection(collection) && samePartnership()
        && request.resource.data.get('id', null) == resource.data.get('id', null);
    }
  }
}
