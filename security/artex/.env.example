# Copy this file to the ARTEX checkout as .env. Never commit the filled-in file.
ARTEX_BIND_ADDR=127.0.0.1
ARTEX_TRUSTED_PROXIES=
POSTGRES_USER=artex
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=artex

# Set one provider key locally. Keep the filled-in file outside Git.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Initial, low-traffic assessment settings. ARTEX's noise profile does not
# limit every command an agent can launch; review commands in the UI.
ARTEX_NOISE_PROFILE=quiet
ARTEX_UNTRUSTED_BOUNDARY=1
ARTEX_TARGET_USER_AGENT=DuoNest-Authorized-Security-Test/1.0
ARTEX_TASK_BUDGET_TOKENS=250000
ARTEX_TASK_BUDGET_TURNS=80
ARTEX_INTENT_BUDGET_TOKENS=60000
ARTEX_INTENT_BUDGET_TURNS=15
