filters:
  and:
    - 'file.ext == "md"'
properties:
  file.name:
    displayName: Note
  note.tags:
    displayName: Tags
  note.status:
    displayName: Status
  file.mtime:
    displayName: Updated
views:
  - type: table
    name: Documentation
    order:
      - file.name
      - note.tags
      - note.status
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
