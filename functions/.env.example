# Google Analytics 4 property ID (numeric, not the Firebase project ID).
GA4_PROPERTY_ID=
# Optional: comma-separated numeric data stream IDs for the DuoNest iOS and Android apps.
GA4_APP_STREAM_IDS=

# Runtime service account for the API. Use the address for the deployment project.
DUO_API_SERVICE_ACCOUNT=duonest-api@duonest-38dc2.iam.gserviceaccount.com

# Observe App Check failures before enabling enforcement.
DUO_APP_CHECK_MONITOR=true
DUO_APP_CHECK_ENFORCE=false
